# انسخ هذا الملف إلى .env ثم ضع مفتاح NVIDIA NIM الخاص بك.
# لا ترفع .env ولا ترسله داخل حزمة التسليم.

NVIDIA_GM_ENABLED=true
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_API_MODEL=nvidia/nemotron-3-super-120b-a12b

# الوضع الموصى به أثناء اللعب: سياق مختصر وسرد أطول من الإعداد السابق دون إرسال كل السجل.
# استخدم full فقط للمشاهد المهمة؛ فهو أبطأ لأنه يرسل سياقًا أوسع.
NVIDIA_GM_CONTEXT_MODE=compact

# تعطيل التفكير المطوّل يقلل زمن الاستجابة ويحافظ على JSON نظيف.
NVIDIA_GM_ENABLE_THINKING=false
NVIDIA_GM_TIMEOUT_SECONDS=60
NVIDIA_GM_TEMPERATURE=1.0
NVIDIA_GM_TOP_P=0.95

# 900 مناسب للسرد المتوازن. ارفع إلى 1400 فقط عند الحاجة إلى مشهد عميق.
NVIDIA_GM_MAX_TOKENS=900

# فعّله مؤقتًا لقياس زمن الطلب من نافذة الخادم، ثم أعده إلى false.
NVIDIA_GM_LOG_TIMING=false
